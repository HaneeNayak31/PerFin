# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL 15+ connection string for development.
DATABASE_URL="postgresql://user:password@localhost:5432/perfin"
# Secret used to sign login tokens. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ── Optional (defaults shown) ───────────────────────────────────────────────
# PORT=4000
# NODE_ENV=development
# Frontend origin(s) allowed by CORS and the CSRF origin check (comma-separated).
# FRONTEND_ORIGIN="http://localhost:3000"
# Login session length in seconds (default 1 day).
# JWT_EXPIRES_IN_SECONDS=86400
# Cookie settings. COOKIE_SECURE defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# Login/register attempts allowed per IP per 15 minutes.
# AUTH_RATE_LIMIT_MAX=10
# Time zone used for month boundaries, "this month" and YYYY-MM-DD dates.
# REPORTING_TIMEZONE="Asia/Kolkata"

# ── AI (optional) ───────────────────────────────────────────────────────────
# Without a key the app still works; AI endpoints return calculated figures
# and say that AI is unavailable.
# AI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# AI_TIMEOUT_MS=15000

# ── Tests ───────────────────────────────────────────────────────────────────
# Separate, disposable database for `npm run test:integration`.
# Its name must contain "test"; all tables in it are emptied between tests.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/perfin_test"
